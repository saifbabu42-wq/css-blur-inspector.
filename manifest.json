
{
  "manifest_version": 3,
  "name": "CSS Blur Inspector",
  "version": "1.0.0",
  "description": "Inspect and toggle CSS blur on the current tab.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "CSS Blur Inspector",
    "default_popup": "popup.html"
  }
}
